<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Filter Settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.filter>
                        <type>array</type>
                        <el>
                            <primary_department>
                                <label>Primary Department</label>
                                <config>
                                    <type>group</type>
                                    <allowed>tx_spark_department</allowed>
                                    <size>1</size>
                                    <maxitems>1</maxitems>
                                    <minitems>0</minitems>
                                </config>
                            </primary_department>
                            <academic_rank>
                                <label>Academic Rank</label>
                                <config>
                                    <type>group</type>
                                    <allowed>tx_spark_person_academic_rank</allowed>
                                    <size>1</size>
                                    <maxitems>1</maxitems>
                                    <minitems>0</minitems>
                                </config>
                            </academic_rank>
                            <academic_title>
                                <label>Academic Title</label>
                                <config>
                                    <type>group</type>
                                    <allowed>tx_spark_person_academic_title</allowed>
                                    <size>1</size>
                                    <maxitems>1</maxitems>
                                    <minitems>0</minitems>
                                </config>
                            </academic_title>
                        </el>
                    </settings.filter>
                    <settings.detailPid>
                        <label>Detail Page</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
