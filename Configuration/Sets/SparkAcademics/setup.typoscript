#
# Setup for spark_academics
#
# Author: Ernedin Zajko <ezajko@root.ba>

# =============================================================================
# Pi1 - List Plugin
# =============================================================================
plugin.tx_sparkacademics_pi1 {
    # Settings structure for FlexForm override
    settings {
        # Entity type selection (default, overridden by FlexForm)
        entityType = Organization
        
        # View settings - no defaults here, FlexForm provides values
        view {
            # viewType intentionally not set - comes from FlexForm
            detailPid = 
            pagination {
                # Maximum total items to display (0 = unlimited)
                limit = 0
                # Items per page (0 = show all without pagination)
                itemsPerPage = 10
            }
        }
        
        # Filter settings (populated by FlexForm)
        filter {
            organization = 0
            organizationType = 0
            academicRank = 0
            studyCycle = 0
            courseCategory = 0
            projectStatus = 0
            projectType = 0
            fundingProgram = 0
        }
        
        # Selection settings (populated by FlexForm)
        select {
            organization =
            person =
            course =
            studyprogram =
            project =
        }
    }
}

# =============================================================================
# Pi2 - Detail Plugin
# =============================================================================
plugin.tx_sparkacademics_pi2 {
    # Unify namespace so Pi2 (Detail) can read Pi1 (List) arguments
    view.pluginNamespace = tx_sparkacademics_pi1
    
    # Settings structure for FlexForm override
    settings {
        # Entity type selection
        entityType = Organization
        
        # View settings - no defaults, FlexForm provides values
        view {
            # viewType intentionally not set - comes from FlexForm
            listPid = 
        }
        
        # Selection settings (populated by FlexForm)
        select {
            organization =
            person =
            course =
            studyprogram =
            project =
        }
    }
}
