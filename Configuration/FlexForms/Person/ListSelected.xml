<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.persons>
                        <label>Select Persons</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_person</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.persons>
                    <settings.detailPid>
                        <label>Detail Page</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
