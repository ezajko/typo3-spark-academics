<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.mode>
                        <TCEforms>
                            <label>Display Mode</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">All Records</numIndex>
                                        <numIndex index="1">all</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Selected Records</numIndex>
                                        <numIndex index="1">selected</numIndex>
                                    </numIndex>
                                </items>
                                <default>all</default>
                            </config>
                        </TCEforms>
                    </settings.mode>
                    <settings.persons>
                        <TCEforms>
                            <label>Select Persons</label>
                            <displayCond>FIELD:settings.mode:=:selected</displayCond>
                            <config>
                                <type>group</type>
                                <allowed>tx_spark_person</allowed>
                                <maxitems>99</maxitems>
                                <minitems>0</minitems>
                                <size>5</size>
                            </config>
                        </TCEforms>
                    </settings.persons>
                </el>
            </ROOT>
        </sDEF>
        <s_filters>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Filters</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.filter.primary_department>
                        <TCEforms>
                            <label>Primary Department</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <foreign_table>tx_spark_department</foreign_table>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0"></numIndex>
                                        <numIndex index="1">0</numIndex>
                                    </numIndex>
                                </items>
                                <default>0</default>
                            </config>
                        </TCEforms>
                    </settings.filter.primary_department>
                    <settings.filter.academic_rank>
                        <TCEforms>
                            <label>Academic Rank</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <foreign_table>tx_spark_academic_rank</foreign_table>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0"></numIndex>
                                        <numIndex index="1">0</numIndex>
                                    </numIndex>
                                </items>
                                <default>0</default>
                            </config>
                        </TCEforms>
                    </settings.filter.academic_rank>
                    <settings.filter.academic_title>
                        <TCEforms>
                            <label>Academic Title</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <foreign_table>tx_spark_academic_title</foreign_table>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0"></numIndex>
                                        <numIndex index="1">0</numIndex>
                                    </numIndex>
                                </items>
                                <default>0</default>
                            </config>
                        </TCEforms>
                    </settings.filter.academic_title>
                </el>
            </ROOT>
        </s_filters>
    </sheets>
</T3DataStructure>
