<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <ROOT>
        <TCEforms>
            <sheetTitle>Person Settings</sheetTitle>
            <displayCond>FIELD:settings.entityType:=:Person</displayCond>
        </TCEforms>
        <type>array</type>
        <el>
            <settings.filter.organization>
                <label>Organization (Any)</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_academics_organization</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Organizations --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.organization>

            <settings.select.person>
                <label>Select Persons</label>
                <config>
                    <type>group</type>
                    <internal_type>db</internal_type>
                    <allowed>tx_academics_person</allowed>
                    <size>5</size>
                    <maxitems>99</maxitems>
                    <minitems>0</minitems>
                </config>
            </settings.select.person>
        </el>
    </ROOT>
</T3DataStructure>
