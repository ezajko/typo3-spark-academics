<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>General Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <!-- Entity Type (Triggers Reload) -->
                    <settings.entityType>
                        <label>Entity Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">Department</numIndex>
                                    <numIndex index="1">Department</numIndex>
                                </numIndex>
                                <numIndex index="1">
                                    <numIndex index="0">Research Lab</numIndex>
                                    <numIndex index="1">ResearchLab</numIndex>
                                </numIndex>
                                <numIndex index="2">
                                    <numIndex index="0">Research Group</numIndex>
                                    <numIndex index="1">ResearchGroup</numIndex>
                                </numIndex>
                                <numIndex index="3">
                                    <numIndex index="0">Chair</numIndex>
                                    <numIndex index="1">Chair</numIndex>
                                </numIndex>
                                <numIndex index="4">
                                    <numIndex index="0">Course</numIndex>
                                    <numIndex index="1">Course</numIndex>
                                </numIndex>
                                <numIndex index="5">
                                    <numIndex index="0">Study Program</numIndex>
                                    <numIndex index="1">StudyProgram</numIndex>
                                </numIndex>
                                <numIndex index="6">
                                    <numIndex index="0">Project</numIndex>
                                    <numIndex index="1">Project</numIndex>
                                </numIndex>
                                <numIndex index="7">
                                    <numIndex index="0">Person</numIndex>
                                    <numIndex index="1">Person</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.entityType>

                    <settings.detailPid>
                        <label>Detail Page (overrides global site setting)</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>

        <!-- Pagination Sheet -->
        <s_pagination>
             <ROOT>
                <TCEforms>
                    <sheetTitle>Pagination</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <xi:include href="EXT:spark_academics/Configuration/FlexForms/Partials/Pagination.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(//T3DataStructure/*)" />
                </el>
            </ROOT>
        </s_pagination>

        <!-- Person Sheet -->
        <s_person>
             <xi:include href="EXT:spark_academics/Configuration/FlexForms/Entities/Person/List.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(//T3DataStructure/*)" />
        </s_person>

        <!-- Project Sheet -->
        <s_project>
             <xi:include href="EXT:spark_academics/Configuration/FlexForms/Entities/Project/List.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(//T3DataStructure/*)" />
        </s_project>

        <!-- Course Sheet -->
        <s_course>
             <xi:include href="EXT:spark_academics/Configuration/FlexForms/Entities/Course/List.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(//T3DataStructure/*)" />
        </s_course>

        <!-- Study Program Sheet -->
        <s_studyprogram>
             <xi:include href="EXT:spark_academics/Configuration/FlexForms/Entities/StudyProgram/List.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(//T3DataStructure/*)" />
        </s_studyprogram>

         <!-- Organizational Sheets (Department, Chair, Labs, Groups) - Condensed for now since they are simple Selection -->
         <!-- For brevity, I will add Department selections inline or create simple sheets later. -->
         <!-- Re-adding simple selections for Organizational units below to ensure BC -->
         <s_department>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Department Settings</sheetTitle>
                    <displayCond>FIELD:settings.entityType:=:Department</displayCond>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.select.department>
                        <label>Select Departments</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_department</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.department>
                </el>
            </ROOT>
         </s_department>

         <s_chair>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Chair Settings</sheetTitle>
                    <displayCond>FIELD:settings.entityType:=:Chair</displayCond>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.select.chair>
                        <label>Select Chairs</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_chair</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.chair>
                </el>
            </ROOT>
         </s_chair>

          <s_researchlab>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Research Lab Settings</sheetTitle>
                    <displayCond>FIELD:settings.entityType:=:ResearchLab</displayCond>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.select.researchlab>
                        <label>Select Research Labs</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_research_lab</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.researchlab>
                </el>
            </ROOT>
         </s_researchlab>

         <s_researchgroup>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Research Group Settings</sheetTitle>
                    <displayCond>FIELD:settings.entityType:=:ResearchGroup</displayCond>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.select.researchgroup>
                        <label>Select Research Groups</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_research_group</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.researchgroup>
                </el>
            </ROOT>
         </s_researchgroup>

    </sheets>
</T3DataStructure>
