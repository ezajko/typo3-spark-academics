<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.detailPid>
                        <TCEforms>
                            <label>Detail Page (overrides global site setting)</label>
                            <config>
                                <type>group</type>
                                <internal_type>db</internal_type>
                                <allowed>pages</allowed>
                                <size>1</size>
                                <maxitems>1</maxitems>
                                <minitems>0</minitems>
                                <show_thumbs>1</show_thumbs>
                                <suggestOptions>
                                    <default>
                                        <searchWholePhrase>1</searchWholePhrase>
                                    </default>
                                </suggestOptions>
                            </config>
                        </TCEforms>
                    </settings.detailPid>
                    
                    <settings.entityType>
                        <TCEforms>
                            <label>Entity Type (managed by system)</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Department</numIndex>
                                        <numIndex index="1">department</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Research Lab</numIndex>
                                        <numIndex index="1">lab</numIndex>
                                    </numIndex>
                                    <numIndex index="2">
                                        <numIndex index="0">Research Group</numIndex>
                                        <numIndex index="1">group</numIndex>
                                    </numIndex>
                                    <numIndex index="3">
                                        <numIndex index="0">Chair</numIndex>
                                        <numIndex index="1">chair</numIndex>
                                    </numIndex>
                                    <numIndex index="4">
                                        <numIndex index="0">Course</numIndex>
                                        <numIndex index="1">course</numIndex>
                                    </numIndex>
                                    <numIndex index="5">
                                        <numIndex index="0">Study Program</numIndex>
                                        <numIndex index="1">program</numIndex>
                                    </numIndex>
                                    <numIndex index="6">
                                        <numIndex index="0">Project</numIndex>
                                        <numIndex index="1">project</numIndex>
                                    </numIndex>
                                    <numIndex index="7">
                                        <numIndex index="0">Person</numIndex>
                                        <numIndex index="1">person</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.entityType>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
