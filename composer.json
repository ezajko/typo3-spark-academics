{
    "name": "rootba/typo3-academics",
    "type": "typo3-cms-extension",
    "description": "Academic management system for TYPO3",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ernedin Zajko",
            "email": "ezajko@root.ba"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-beuser": "^13.4 || ^14.0",
        "rootba/typo3-spark-core": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "RootBa\\Academics\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RootBa\\Academics\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "academics"
        }
    }
}