<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>General</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.mode>
                        <TCEforms>
                            <label>Display Mode</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">All Persons</numIndex>
                                        <numIndex index="1">all</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Selected Persons</numIndex>
                                        <numIndex index="1">selected</numIndex>
                                    </numIndex>
                                </items>
                                <default>all</default>
                            </config>
                        </TCEforms>
                    </settings.mode>
                    <settings.persons>
                        <TCEforms>
                            <label>Select Persons</label>
                            <displayCond>FIELD:settings.mode:=:selected</displayCond>
                            <config>
                                <type>group</type>
                                <allowed>tx_spark_person</allowed>
                                <size>5</size>
                                <maxitems>99</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.persons>
                    <settings.detailPid>
                         <TCEforms>
                             <label>Detail Page</label>
                             <config>
                                 <type>group</type>
                                 <allowed>pages</allowed>
                                 <size>1</size>
                                 <maxitems>1</maxitems>
                                 <minitems>0</minitems>
                             </config>
                         </TCEforms>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
        <sFILTERS>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Filters (Only for 'All' mode)</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.filter_primary_department>
                        <TCEforms>
                            <label>Primary Department</label>
                            <config>
                                <type>group</type>
                                <allowed>tx_spark_department</allowed>
                                <size>1</size>
                                <maxitems>1</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.filter_primary_department>
                    <settings.filter_academic_rank>
                        <TCEforms>
                            <label>Academic Rank</label>
                            <config>
                                <type>group</type>
                                <allowed>tx_spark_person_academic_rank</allowed>
                                <size>1</size>
                                <maxitems>1</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.filter_academic_rank>
                    <settings.filter_academic_title>
                        <TCEforms>
                            <label>Academic Title</label>
                            <config>
                                <type>group</type>
                                <allowed>tx_spark_person_academic_title</allowed>
                                <size>1</size>
                                <maxitems>1</maxitems>
                                <minitems>0</minitems>
                            </config>
                        </TCEforms>
                    </settings.filter_academic_title>
                </el>
            </ROOT>
        </sFILTERS>
    </sheets>
</T3DataStructure>
