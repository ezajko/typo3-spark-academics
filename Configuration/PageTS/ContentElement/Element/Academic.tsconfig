# Configuration for Spark Academics View Types
# This file controls the available options in the "View Type" dropdown
# for each entity type in the Academic List Plugin (Pi1).
#
# Documentation:
# Use 'addItems' to add additional view types to the dropdown.
# Base item 'Default' is defined in FlexForm, addItems adds Simple/Debug.
# Each entity has its own unique key: settings.view.viewType.{entity}
#
# IMPORTANT: Field names containing dots MUST be escaped with backslash.
#
# Author: Ernedin Zajko <ezajko@root.ba>

# --------------------------------------------------------------------------
# View Types Configuration per Entity Sheet
# Note: Each entity uses a unique key to avoid FlexForm value conflicts
# --------------------------------------------------------------------------

# Organization ViewTypes (sOrganization sheet)
TCEFORM.tt_content.pi_flexform.sparkacademics_pi1.sOrganization.settings\.view\.viewType\.organization {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

# Person ViewTypes (sPerson sheet)
TCEFORM.tt_content.pi_flexform.sparkacademics_pi1.sPerson.settings\.view\.viewType\.person {
    addItems {
        Card = Card
        Simple = Simple
        Debug = Debug
    }
}

# Course ViewTypes (sCourse sheet)
TCEFORM.tt_content.pi_flexform.sparkacademics_pi1.sCourse.settings\.view\.viewType\.course {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

# StudyProgram ViewTypes (sStudyProgram sheet)
TCEFORM.tt_content.pi_flexform.sparkacademics_pi1.sStudyProgram.settings\.view\.viewType\.studyprogram {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

# Project ViewTypes (sProject sheet)
TCEFORM.tt_content.pi_flexform.sparkacademics_pi1.sProject.settings\.view\.viewType\.project {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

# --------------------------------------------------------------------------
# Detail Plugin (Pi2) - Uses same unique key structure per entity
# --------------------------------------------------------------------------
TCEFORM.tt_content.pi_flexform.sparkacademics_pi2.sOrganization.settings\.view\.viewType\.organization {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

TCEFORM.tt_content.pi_flexform.sparkacademics_pi2.sPerson.settings\.view\.viewType\.person {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

TCEFORM.tt_content.pi_flexform.sparkacademics_pi2.sCourse.settings\.view\.viewType\.course {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

TCEFORM.tt_content.pi_flexform.sparkacademics_pi2.sStudyProgram.settings\.view\.viewType\.studyprogram {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}

TCEFORM.tt_content.pi_flexform.sparkacademics_pi2.sProject.settings\.view\.viewType\.project {
    addItems {
        Simple = Simple
        Debug = Debug
    }
}
