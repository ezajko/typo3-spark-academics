<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>


                    <!-- Entity Type (Triggers Reload) -->
                    <settings.entityType>
                        <label>Entity Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">Department</numIndex>
                                    <numIndex index="1">Department</numIndex>
                                </numIndex>
                                <numIndex index="1">
                                    <numIndex index="0">Research Lab</numIndex>
                                    <numIndex index="1">ResearchLab</numIndex>
                                </numIndex>
                                <numIndex index="2">
                                    <numIndex index="0">Research Group</numIndex>
                                    <numIndex index="1">ResearchGroup</numIndex>
                                </numIndex>
                                <numIndex index="3">
                                    <numIndex index="0">Chair</numIndex>
                                    <numIndex index="1">Chair</numIndex>
                                </numIndex>
                                <numIndex index="4">
                                    <numIndex index="0">Course</numIndex>
                                    <numIndex index="1">Course</numIndex>
                                </numIndex>
                                <numIndex index="5">
                                    <numIndex index="0">Study Program</numIndex>
                                    <numIndex index="1">StudyProgram</numIndex>
                                </numIndex>
                                <numIndex index="6">
                                    <numIndex index="0">Project</numIndex>
                                    <numIndex index="1">Project</numIndex>
                                </numIndex>
                                <numIndex index="7">
                                    <numIndex index="0">Person</numIndex>
                                    <numIndex index="1">Person</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.entityType>

                    <!-- Pagination Settings -->
                    <settings.view.pagination.limit>
                        <label>LLL:EXT:spark_academics/Resources/Private/Language/locallang.xlf:flexform.pagination.limit</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.view.pagination.limit>

                    <settings.view.pagination.itemsPerPage>
                        <label>LLL:EXT:spark_academics/Resources/Private/Language/locallang.xlf:flexform.pagination.itemsPerPage</label>
                        <config>
                            <type>number</type>
                            <default>10</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.view.pagination.itemsPerPage>

                    <!-- Person Specific Filters (displayCond) -->
                    <settings.filter.primary_department>
                        <label>Primary Department</label>
                        <displayCond>FIELD:settings.entityType:=:Person</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_department</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Departments --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.primary_department>

                    <settings.filter.department>
                        <label>Department (Any)</label>
                        <displayCond>
                            <OR>
                                <numIndex index="0">FIELD:settings.entityType:=:Person</numIndex>
                                <numIndex index="1">FIELD:settings.entityType:=:Project</numIndex>
                                <numIndex index="2">FIELD:settings.entityType:=:Course</numIndex>
                            </OR>
                        </displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_department</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Departments --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.department>

                    <settings.filter.academic_rank>
                        <label>Filter by Academic Rank</label>
                        <displayCond>FIELD:settings.entityType:=:Person</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">All Ranks</numIndex>
                                    <numIndex index="1">0</numIndex>
                                </numIndex>
                            </items>
                            <foreign_table>tx_spark_academic_rank</foreign_table>
                        </config>
                    </settings.filter.academic_rank>

                    <settings.filter.research_group>
                        <label>Filter by Research Group</label>
                        <displayCond>
                            <OR>
                                <numIndex index="0">FIELD:settings.entityType:=:Person</numIndex>
                                <numIndex index="1">FIELD:settings.entityType:=:Project</numIndex>
                            </OR>
                        </displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_research_group</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Groups --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.research_group>

                    <settings.filter.research_lab>
                        <label>Filter by Research Lab</label>
                        <displayCond>
                            <OR>
                                <numIndex index="0">FIELD:settings.entityType:=:Person</numIndex>
                                <numIndex index="1">FIELD:settings.entityType:=:Project</numIndex>
                            </OR>
                        </displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_research_lab</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Labs --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.research_lab>

                    <settings.filter.chair>
                        <label>Filter by Chair</label>
                        <displayCond>
                            <OR>
                                <numIndex index="0">FIELD:settings.entityType:=:Person</numIndex>
                                <numIndex index="1">FIELD:settings.entityType:=:Project</numIndex>
                                <numIndex index="2">FIELD:settings.entityType:=:Course</numIndex>
                            </OR>
                        </displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_chair</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Chairs --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.chair>

                    <!-- Course Specific Filters -->
                    <settings.filter.study_cycle>
                        <label>Filter by Study Cycle</label>
                        <displayCond>FIELD:settings.entityType:=:Course</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_study_cycle</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Cycles --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.study_cycle>

                    <settings.filter.course_category>
                        <label>Filter by Category</label>
                        <displayCond>FIELD:settings.entityType:=:Course</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_course_category</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Categories --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.course_category>

                    <settings.filter.scientific_field>
                        <label>Filter by Scientific Field</label>
                        <displayCond>FIELD:settings.entityType:=:Course</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_scientific_field</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Fields --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.scientific_field>

                    <!-- Project Specific Filters -->
                    <settings.filter.project_status>
                        <label>Filter by Status</label>
                        <displayCond>FIELD:settings.entityType:=:Project</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_project_status</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Statuses --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.filter.project_status>

                    <settings.filter.project_type>
                        <label>Filter by Type</label>
                        <displayCond>FIELD:settings.entityType:=:Project</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_project_type</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Types --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.filter.project_type>

                    <settings.filter.funding_program>
                        <label>Filter by Funding Program</label>
                        <displayCond>FIELD:settings.entityType:=:Project</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_funding_program</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Programs --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.filter.funding_program>

                    <!-- Selection Fields -->
                    <settings.select.department>
                        <label>Select Departments</label>
                        <displayCond>FIELD:settings.entityType:=:Department</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_department</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.department>
                    <settings.select.researchlab>
                        <label>Select Research Labs</label>
                        <displayCond>FIELD:settings.entityType:=:ResearchLab</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_research_lab</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.researchlab>
                    <settings.select.researchgroup>
                        <label>Select Research Groups</label>
                        <displayCond>FIELD:settings.entityType:=:ResearchGroup</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_research_group</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.researchgroup>
                    <settings.select.chair>
                        <label>Select Chairs</label>
                        <displayCond>FIELD:settings.entityType:=:Chair</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_chair</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.chair>
                    <settings.select.course>
                        <label>Select Courses</label>
                        <displayCond>FIELD:settings.entityType:=:Course</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_course</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.course>
                    <settings.select.studyprogram>
                        <label>Select Study Programs</label>
                        <displayCond>FIELD:settings.entityType:=:StudyProgram</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_study_program</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.studyprogram>
                    <settings.select.project>
                        <label>Select Projects</label>
                        <displayCond>FIELD:settings.entityType:=:Project</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_project</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.project>
                    <settings.select.person>
                        <label>Select Persons</label>
                        <displayCond>FIELD:settings.entityType:=:Person</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_person</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.person>

                    <settings.detailPid>
                        <label>Detail Page (overrides global site setting)</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
