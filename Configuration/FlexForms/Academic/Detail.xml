<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>General Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.entityType>
                        <label>Entity Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <numIndex index="0">Organization</numIndex>
                                    <numIndex index="1">Organization</numIndex>
                                </numIndex>
                                <numIndex index="1">
                                    <numIndex index="0">Course</numIndex>
                                    <numIndex index="1">Course</numIndex>
                                </numIndex>
                                <numIndex index="2">
                                    <numIndex index="0">Study Program</numIndex>
                                    <numIndex index="1">StudyProgram</numIndex>
                                </numIndex>
                                <numIndex index="3">
                                    <numIndex index="0">Project</numIndex>
                                    <numIndex index="1">Project</numIndex>
                                </numIndex>
                                <numIndex index="4">
                                    <numIndex index="0">Person</numIndex>
                                    <numIndex index="1">Person</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </settings.entityType>

                    <settings.select.organization>
                        <label>Select Organization</label>
                        <displayCond>FIELD:settings.entityType:=:Organization</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_organization</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.organization>
                    
                    <settings.select.course>
                        <label>Select Course</label>
                        <displayCond>FIELD:settings.entityType:=:Course</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_course</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.course>

                    <settings.select.studyprogram>
                        <label>Select Study Program</label>
                        <displayCond>FIELD:settings.entityType:=:StudyProgram</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_study_program</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.studyprogram>

                    <settings.select.project>
                        <label>Select Project</label>
                        <displayCond>FIELD:settings.entityType:=:Project</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_project</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.project>

                    <settings.select.person>
                        <label>Select Person</label>
                        <displayCond>FIELD:settings.entityType:=:Person</displayCond>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>tx_spark_person</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.person>

                    <settings.listPid>
                        <label>List Page (for back links)</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                        </config>
                    </settings.listPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
