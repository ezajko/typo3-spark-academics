<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <!-- General Settings -->
        <sDEF>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <!-- Entity Type -->
                    <settings.entityType>
                        <label>Entity Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Organization</label>
                                    <value>Organization</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Person</label>
                                    <value>Person</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Course</label>
                                    <value>Course</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Study Program</label>
                                    <value>StudyProgram</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Project</label>
                                    <value>Project</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.entityType>

                    <!-- Detail Page -->
                    <settings.detailPid>
                        <label>Detail Page (optional)</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>

        <!-- Pagination -->
        <sPagination>
            <ROOT>
                <sheetTitle>Pagination</sheetTitle>
                <type>array</type>
                <el>
                    <settings.view.pagination.itemsPerPage>
                        <label>Items per Page (0 = no pagination)</label>
                        <config>
                            <type>number</type>
                            <default>10</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.view.pagination.itemsPerPage>

                    <settings.view.pagination.limit>
                        <label>Maximum Items (0 = unlimited)</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                            <range>
                                <lower>0</lower>
                            </range>
                        </config>
                    </settings.view.pagination.limit>
                </el>
            </ROOT>
        </sPagination>

        <!-- Frontend Filtering -->
        <sFrontendFilter>
            <ROOT>
                <sheetTitle>Frontend Filter</sheetTitle>
                <type>array</type>
                <el>
                    <!-- Enable Frontend Filtering -->
                    <settings.view.frontendFilter.enabled>
                        <label>Enable Frontend Filtering</label>
                        <description>Show filter form on frontend for visitors</description>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.view.frontendFilter.enabled>

                    <!-- Filter Layout -->
                    <settings.view.frontendFilter.layout>
                        <label>Filter Layout</label>
                        <displayCond>FIELD:sFrontendFilter.settings.view.frontendFilter.enabled:=:1</displayCond>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Inline (Horizontal)</label>
                                    <value>inline</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Sidebar (Vertical)</label>
                                    <value>sidebar</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Collapsible Card</label>
                                    <value>collapsible</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.frontendFilter.layout>

                    <!-- Show Search Field -->
                    <settings.view.frontendFilter.showSearch>
                        <label>Show Search Field</label>
                        <displayCond>FIELD:sFrontendFilter.settings.view.frontendFilter.enabled:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.view.frontendFilter.showSearch>

                    <!-- Show Filter Dropdowns -->
                    <settings.view.frontendFilter.showFilters>
                        <label>Show Filter Dropdowns</label>
                        <displayCond>FIELD:sFrontendFilter.settings.view.frontendFilter.enabled:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.view.frontendFilter.showFilters>

                    <!-- Show Reset Button -->
                    <settings.view.frontendFilter.showReset>
                        <label>Show Reset Button</label>
                        <displayCond>FIELD:sFrontendFilter.settings.view.frontendFilter.enabled:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.view.frontendFilter.showReset>
                </el>
            </ROOT>
        </sFrontendFilter>

        <!-- Organization Settings -->
        <sOrganization>
            <ROOT>
                <sheetTitle>Organization</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:Organization</displayCond>
                <type>array</type>
                <el>
                    <!-- View Type for Organization -->
                    <settings.view.viewType.organization>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.organization>

                    <settings.filter.organizationType>
                        <label>Filter by Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_organization_type</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Types --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.organizationType>

                    <settings.select.organization>
                        <label>Select Specific Organizations</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_organization</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.organization>
                </el>
            </ROOT>
        </sOrganization>

