<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <settings.mode>
                        <label>Display Mode</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>All Persons</label>
                                    <value>all</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Selected Persons</label>
                                    <value>selected</value>
                                </numIndex>
                            </items>
                            <default>all</default>
                        </config>
                    </settings.mode>
                    <settings.persons>
                        <label>Select Persons</label>
                        <displayCond>FIELD:settings.mode:=:selected</displayCond>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_person</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.persons>
                    <settings.detailPid>
                         <label>Detail Page</label>
                         <config>
                             <type>group</type>
                             <allowed>pages</allowed>
                             <size>1</size>
                             <maxitems>1</maxitems>
                             <minitems>0</minitems>
                         </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
        <sFILTERS>
            <ROOT>
                <sheetTitle>Filters (Only for 'All' mode)</sheetTitle>
                <type>array</type>
                <el>
                    <settings.filter.primary_department>
                        <label>Primary Department</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_department</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Departments --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.primary_department>
                    <settings.filter.academic_rank>
                        <label>Academic Rank</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_academic_rank</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Ranks --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.academic_rank>
                    <settings.filter.academic_title>
                        <label>Academic Title</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_spark_academic_title</foreign_table>
                            <items>
                                <numIndex index="0">
                                    <label>-- All Titles --</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <minitems>0</minitems>
                        </config>
                    </settings.filter.academic_title>
                </el>
            </ROOT>
        </sFILTERS>
    </sheets>
</T3DataStructure>
