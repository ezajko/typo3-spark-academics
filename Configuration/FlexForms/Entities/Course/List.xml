<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <ROOT>
        <TCEforms>
            <sheetTitle>Course Settings</sheetTitle>
            <displayCond>FIELD:settings.entityType:=:Course</displayCond>
        </TCEforms>
        <type>array</type>
        <el>
            <settings.filter.studyCycle>
                <label>Filter by Study Cycle</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_academics_domain_model_study_cycle</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Cycles --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.studyCycle>

            <settings.filter.courseCategory>
                <label>Filter by Category</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_academics_domain_model_course_category</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Categories --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.courseCategory>

            <settings.filter.scientificField>
                <label>Filter by Scientific Field</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_academics_domain_model_scientific_field</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Fields --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.scientificField>

            <settings.filter.organization>
                <label>Filter by Organization</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_academics_domain_model_organization</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Organizations --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.organization>

            <settings.select.course>
                <label>Select Courses</label>
                <config>
                    <type>group</type>
                    <internal_type>db</internal_type>
                    <allowed>tx_academics_domain_model_course</allowed>
                    <size>5</size>
                    <maxitems>99</maxitems>
                    <minitems>0</minitems>
                </config>
            </settings.select.course>
        </el>
    </ROOT>
</T3DataStructure>
