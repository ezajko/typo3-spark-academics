<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <!-- General Settings -->
        <sDEF>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <!-- Entity Type -->
                    <settings.entityType>
                        <label>Entity Type</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Organization</label>
                                    <value>Organization</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Person</label>
                                    <value>Person</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Course</label>
                                    <value>Course</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Study Program</label>
                                    <value>StudyProgram</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Project</label>
                                    <value>Project</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.entityType>

                    <!-- List Page (for back links) -->
                    <settings.listPid>
                        <label>List Page (for back links)</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.listPid>
                </el>
            </ROOT>
        </sDEF>

        <!-- Organization Settings -->
        <sOrganization>
            <ROOT>
                <sheetTitle>Organization</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:Organization</displayCond>
                <type>array</type>
                <el>
                    <!-- Select Organization -->
                    <settings.select.organization>
                        <label>Select Organization</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_organization</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.organization>

                    <!-- View Type for Organization -->
                    <settings.view.viewType.organization>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.organization>
                </el>
            </ROOT>
        </sOrganization>

        <!-- Person Settings -->
        <sPerson>
            <ROOT>
                <sheetTitle>Person</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:Person</displayCond>
                <type>array</type>
                <el>
                    <!-- Select Person -->
                    <settings.select.person>
                        <label>Select Person</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_person</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.person>

                    <!-- View Type for Person -->
                    <settings.view.viewType.person>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.person>
                </el>
            </ROOT>
        </sPerson>

        <!-- Course Settings -->
        <sCourse>
            <ROOT>
                <sheetTitle>Course</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:Course</displayCond>
                <type>array</type>
                <el>
                    <!-- Select Course -->
                    <settings.select.course>
                        <label>Select Course</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_course</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.course>

                    <!-- View Type for Course -->
                    <settings.view.viewType.course>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.course>
                </el>
            </ROOT>
        </sCourse>

        <!-- Study Program Settings -->
        <sStudyProgram>
            <ROOT>
                <sheetTitle>Study Program</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:StudyProgram</displayCond>
                <type>array</type>
                <el>
                    <!-- Select Study Program -->
                    <settings.select.studyprogram>
                        <label>Select Study Program</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_study_program</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.studyprogram>

                    <!-- View Type for StudyProgram -->
                    <settings.view.viewType.studyprogram>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.studyprogram>
                </el>
            </ROOT>
        </sStudyProgram>

        <!-- Project Settings -->
        <sProject>
            <ROOT>
                <sheetTitle>Project</sheetTitle>
                <displayCond>FIELD:sDEF.settings.entityType:=:Project</displayCond>
                <type>array</type>
                <el>
                    <!-- Select Project -->
                    <settings.select.project>
                        <label>Select Project</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_spark_project</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.select.project>

                    <!-- View Type for Project -->
                    <settings.view.viewType.project>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Default</label>
                                    <value>Default</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.view.viewType.project>
                </el>
            </ROOT>
        </sProject>

    </sheets>
</T3DataStructure>
