<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Filter Settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.filter>
                        <type>array</type>
                        <el>
                            <primary_department>
                                <label>Primary Department</label>
                                <config>
                                    <type>select</type>
                                    <renderType>selectSingle</renderType>
                                    <foreign_table>tx_spark_department</foreign_table>
                                    <items>
                                        <numIndex index="0">
                                            <label>-- All Departments --</label>
                                            <value>0</value>
                                        </numIndex>
                                    </items>
                                    <minitems>0</minitems>
                                </config>
                            </primary_department>
                            <academic_rank>
                                <label>Academic Rank</label>
                                <config>
                                    <type>select</type>
                                    <renderType>selectSingle</renderType>
                                    <foreign_table>tx_spark_person_academic_rank</foreign_table>
                                    <items>
                                        <numIndex index="0">
                                            <label>-- All Ranks --</label>
                                            <value>0</value>
                                        </numIndex>
                                    </items>
                                    <minitems>0</minitems>
                                </config>
                            </academic_rank>
                            <academic_title>
                                <label>Academic Title</label>
                                <config>
                                    <type>select</type>
                                    <renderType>selectSingle</renderType>
                                    <foreign_table>tx_spark_person_academic_title</foreign_table>
                                    <items>
                                        <numIndex index="0">
                                            <label>-- All Titles --</label>
                                            <value>0</value>
                                        </numIndex>
                                    </items>
                                    <minitems>0</minitems>
                                </config>
                            </academic_title>
                        </el>
                    </settings.filter>
                    <settings.detailPid>
                        <label>Detail Page</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.detailPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
