<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <ROOT>
        <TCEforms>
            <sheetTitle>Course Settings</sheetTitle>
            <displayCond>FIELD:settings.entityType:=:Course</displayCond>
        </TCEforms>
        <type>array</type>
        <el>
            <settings.filter.study_cycle>
                <label>Filter by Study Cycle</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_spark_study_cycle</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Cycles --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.study_cycle>

            <settings.filter.course_category>
                <label>Filter by Category</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_spark_course_category</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Categories --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.course_category>

            <settings.filter.scientific_field>
                <label>Filter by Scientific Field</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_spark_scientific_field</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Fields --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.scientific_field>

            <settings.filter.department>
                <label>Department (Any)</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_spark_department</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Departments --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.department>

            <settings.filter.chair>
                <label>Filter by Chair</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <foreign_table>tx_spark_chair</foreign_table>
                    <items>
                        <numIndex index="0">
                            <label>-- All Chairs --</label>
                            <value>0</value>
                        </numIndex>
                    </items>
                    <minitems>0</minitems>
                </config>
            </settings.filter.chair>

            <settings.select.course>
                <label>Select Courses</label>
                <config>
                    <type>group</type>
                    <internal_type>db</internal_type>
                    <allowed>tx_spark_course</allowed>
                    <size>5</size>
                    <maxitems>99</maxitems>
                    <minitems>0</minitems>
                </config>
            </settings.select.course>
        </el>
    </ROOT>
</T3DataStructure>
